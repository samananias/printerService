# Copy this file to ".env" and adjust values. (.env is git-ignored.)

# Address the server listens on. 0.0.0.0 = reachable from the phone over Wi-Fi.
HOST=0.0.0.0
PORT=8000

# Max upload size in megabytes (README Section 8)
MAX_UPLOAD_MB=25

# Optional shared PIN the phone must send with each request (README Section 8).
# Leave empty to disable authentication entirely.
API_PIN=

# Printer to submit jobs to (Phase 5). Empty = the Windows default printer.
PRINTER_NAME=

# Full path to SumatraPDF.exe (Phase 5's PDF printing method). Empty = search
# standard install locations. If set here, it is used as-is (no fallback).
SUMATRA_PATH=
